<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTituloAjustes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_ajustes"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp" />

    <Switch
        android:id="@+id/swNotificaciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/switch_notificaciones"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloAjustes"
        android:layout_marginTop="32dp" />

    <Switch
        android:id="@+id/swModoOscuro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/switch_modo_oscuro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/swNotificaciones"
        android:layout_marginTop="16dp" />

    <CheckBox
        android:id="@+id/cbRecordarSesion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/checkbox_recordar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/swModoOscuro"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvTamanoTextoLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tamano_texto"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cbRecordarSesion"
        android:layout_marginTop="32dp" />

    <SeekBar
        android:id="@+id/sbTamanoTexto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:max="12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTamanoTextoLabel"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvTamanoActual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tamaño: 16sp"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sbTamanoTexto"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnGuardarVolver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_guardar_volver"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>