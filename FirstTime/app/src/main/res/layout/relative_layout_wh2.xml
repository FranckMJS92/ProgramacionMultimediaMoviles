<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <RelativeLayout
            android:id="@+id/view_botton_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/view_center"
            android:layout_toRightOf="@id/view_botton_left"
            android:background="#9C27B0">

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/view_botton_left"
            android:layout_width="150dp"
            android:layout_height="match_parent"
            android:layout_below="@id/view_center"
            android:background="#3F51B5">

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/view_top_left"
            android:layout_width="110dp"
            android:layout_height="100dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_toLeftOf="@id/view_top_center"
            android:background="#99E6EF">

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/view_center"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_below="@id/view_top_center"
            android:background="#4CAF50">

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/view_top_center"
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:layout_toLeftOf="@id/view_top_right"
            android:background="#FF9800">

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/view_top_right"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:background="#FFEB3B">

        </RelativeLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>